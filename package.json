{
  "name": "@local/todo-matrix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A bright four-quadrant todo board with a deadline calendar and priority reminders.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "todo",
    "eisenhower-matrix",
    "calendar",
    "deadline"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Charlucifer/todo-matrix.git"
  },
  "homepage": "https://github.com/Charlucifer/todo-matrix#readme",
  "bugs": {
    "url": "https://github.com/Charlucifer/todo-matrix/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
